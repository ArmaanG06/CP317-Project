# Copy to .env and fill in. Never commit .env.
# Supabase Postgres connection string (Supabase dashboard > Connect), e.g.
# postgresql+psycopg://postgres.<project-ref>:<password>@<host>:5432/postgres
DATABASE_URL=
# Long random string used to sign session tokens
JWT_SECRET=
SESSION_MINUTES=15
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
